[Unit]
Description=Mosquitto ESP32 HMI on Raspberry Pi CM5 Lite
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Environment="QT_QPA_PLATFORM=eglfs"
Environment="QT_QPA_EGLFS_ALWAYS_SET_MODE=1"
Environment="QT_QPA_GENERIC_PLUGINS=evdevtouch,evdevmouse,evdevkeyboard"
WorkingDirectory=/home/pi/mqtt_esp/rpi_hmi/build
ExecStart=/home/pi/mqtt_esp/rpi_hmi/build/rpi_esp_hmi
Restart=on-failure
RestartSec=3s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
